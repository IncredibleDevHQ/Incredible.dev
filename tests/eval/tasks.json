{
  "version": 1,
  "brand": "examples/brands/example-studio",
  "tasks": [
    {"id": "ad-set-4", "kind": "still", "prompt": "Make an ad set announcing Example Studio 2.0 with the line \"Every size, one pass.\" in 1080x1080, 1080x1350, 1200x628 and 1080x1920.", "expect": {"outputs": [{"glob": "*1080x1080*", "size": "1080x1080"}, {"glob": "*1080x1350*", "size": "1080x1350"}, {"glob": "*1200x628*", "size": "1200x628"}, {"glob": "*1080x1920*", "size": "1080x1920"}], "copy": ["Every size, one pass."], "max_questions": 0}, "budget": {"minutes": 15, "usd": 3}},
    {"id": "linkedin-card", "kind": "still", "prompt": "A LinkedIn card for our webinar \"Design systems that ship\" on 12 November.", "expect": {"outputs": [{"glob": "*.png", "size": "1200x627|1080x1350"}], "copy": ["Design systems that ship"], "max_questions": 1}, "budget": {"minutes": 10, "usd": 2}},
    {"id": "restyle-layout", "kind": "still", "attachments": ["fixtures/supplied-layout.png"], "prompt": "Restyle this layout in our brand. Keep the structure and the copy.", "expect": {"outputs": [{"glob": "*.png"}], "max_questions": 0, "behaviors": ["uses_look"]}, "budget": {"minutes": 15, "usd": 3}},
    {"id": "carousel-5", "kind": "still", "prompt": "A 5-slide Instagram carousel (1080x1350) on three habits of teams that design fast: write the brief, name the decision, show the work.", "expect": {"outputs": [{"glob": "*.png", "size": "1080x1350", "count": 5}], "max_questions": 0}, "budget": {"minutes": 20, "usd": 4}},
    {"id": "one-pager-pdf", "kind": "still", "prompt": "A one-page A4 PDF introducing Example Studio's design review service: what it is, how it works in three steps, and how to book.", "expect": {"outputs": [{"glob": "*.pdf"}], "max_questions": 1}, "budget": {"minutes": 15, "usd": 3}},
    {"id": "deck-10", "kind": "deck", "prompt": "A 10-slide static deck (PDF, 16:9) for a quarterly design review: agenda, three wins, two misses, metrics, next quarter's bets, asks.", "expect": {"outputs": [{"glob": "*.pdf"}], "max_questions": 1}, "budget": {"minutes": 30, "usd": 6}},
    {"id": "flywheel", "kind": "diagram", "prompt": "A flywheel diagram: brief, design, review, ship, learn, back to brief.", "expect": {"outputs": [{"glob": "*.png"}], "copy": ["brief", "design", "review", "ship", "learn"], "copyCase": "any", "max_questions": 0}, "budget": {"minutes": 10, "usd": 2}},
    {"id": "architecture-diagram", "kind": "diagram", "prompt": "A diagram of how a request flows: Slack, the agent, its helpers, the sandbox, and the delivered files back to Slack.", "expect": {"outputs": [{"glob": "*.png"}], "max_questions": 0}, "budget": {"minutes": 10, "usd": 2}},
    {"id": "bar-chart", "kind": "chart", "prompt": "A bar chart of weekly signups (W1 120, W2 180, W3 260, W4 410) with an annotation on W4: \"launch week\".", "expect": {"outputs": [{"glob": "*.png"}], "copy": ["launch week"], "max_questions": 0}, "budget": {"minutes": 10, "usd": 2}},
    {"id": "stat-card", "kind": "chart", "prompt": "A stat card: 3.4x faster first drafts.", "expect": {"outputs": [{"glob": "*.png"}], "copy": ["3.4x"], "max_questions": 0, "behaviors": ["fewest_words"]}, "budget": {"minutes": 8, "usd": 1.5}},
    {"id": "thumbnail-set", "kind": "thumbnail", "prompt": "Three thumbnail options for our video \"How we review designs in 10 minutes\".", "expect": {"outputs": [{"glob": "*.png", "size": "1280x720|3840x2160", "count": 3}], "max_questions": 0}, "budget": {"minutes": 15, "usd": 3}},
    {"id": "storyboard", "kind": "storyboard", "prompt": "Storyboard a 20-second teaser for Example Studio 2.0. Just the storyboard for now.", "expect": {"outputs": [{"glob": "*.[jp][pn]g"}], "max_questions": 1, "behaviors": ["no_render"]}, "budget": {"minutes": 20, "usd": 4}},
    {"id": "teaser-15", "kind": "film", "prompt": "A 15-second 1920x1080 teaser for Example Studio 2.0.", "follow_ups": ["Looks good, go ahead."], "expect": {"outputs": [{"glob": "*.mp4", "size": "1920x1080", "seconds": 15}], "max_questions": 1, "behaviors": ["storyboard_first", "gates_before_render"]}, "budget": {"minutes": 45, "usd": 10}},
    {"id": "logo-sting", "kind": "film", "prompt": "A 4-second logo sting with our mark, 1080x1080.", "follow_ups": ["Approved."], "expect": {"outputs": [{"glob": "*.mp4", "size": "1080x1080", "seconds": 4}], "max_questions": 0, "behaviors": ["gates_before_render"]}, "budget": {"minutes": 25, "usd": 5}},
    {"id": "stat-motion", "kind": "film", "prompt": "An 8-second motion graphic: signups grew from 120 to 410 in four weeks. Square.", "follow_ups": ["Go ahead."], "expect": {"outputs": [{"glob": "*.mp4", "size": "1080x1080", "seconds": 8}], "copy": ["410"], "behaviors": ["storyboard_first", "gates_before_render"]}, "budget": {"minutes": 30, "usd": 6}},
    {"id": "launch-film-45", "kind": "film", "prompt": "A 45-second launch film for Example Studio 2.0 with a voiceover, 1920x1080.", "follow_ups": ["The storyboard works. Build it.", "approve"], "expect": {"outputs": [{"glob": "*.mp4", "size": "1920x1080", "seconds": 45}], "behaviors": ["storyboard_first", "gates_before_render"]}, "budget": {"minutes": 120, "usd": 40}, "needs": ["ELEVENLABS_API_KEY"]},
    {"id": "gif-loop", "kind": "still", "prompt": "A 3-second looping GIF of our mark drawing its horizon line, 600x600, under 2 MB.", "expect": {"outputs": [{"glob": "*.gif", "size": "600x600"}], "max_questions": 0}, "budget": {"minutes": 15, "usd": 3}},
    {"id": "image-plate", "kind": "still", "prompt": "Generate a calm abstract paper-texture background in our palette and set our headline \"Make the next thing\" on it, 1600x900.", "expect": {"outputs": [{"glob": "*.png", "size": "1600x900"}], "copy": ["Make the next thing"]}, "budget": {"minutes": 15, "usd": 3}, "needs": ["OPENAI_API_KEY"]},
    {"id": "resize-supplied", "kind": "still", "attachments": ["fixtures/supplied-layout.png"], "prompt": "Crop this to 1:1 at 1080 and convert it to WebP.", "expect": {"outputs": [{"glob": "*.webp", "size": "1080x1080"}], "max_questions": 0}, "budget": {"minutes": 5, "usd": 1}},
    {"id": "vague-ask", "kind": "behavior", "prompt": "Make something for the launch.", "expect": {"max_questions": 2, "behaviors": ["decides_or_asks"]}, "budget": {"minutes": 15, "usd": 3}},
    {"id": "exact-copy", "kind": "behavior", "prompt": "A square card with exactly this text and nothing else: \"Ship it Friday.\"", "expect": {"outputs": [{"glob": "*.png", "size": "1080x1080"}], "copy": ["Ship it Friday."], "behaviors": ["fewest_words"]}, "budget": {"minutes": 8, "usd": 1.5}},
    {"id": "no-logo-brand", "kind": "behavior", "brand": "fixtures/brand-without-logos", "prompt": "Make a launch card with our logo in the corner.", "expect": {"behaviors": ["no_invented_logo"]}, "budget": {"minutes": 10, "usd": 2}},
    {"id": "honest-delivery", "kind": "behavior", "prompt": "Make a 1080x1080 card that says \"Doors open at 9\" and send it here.", "expect": {"outputs": [{"glob": "*.png", "size": "1080x1080"}], "behaviors": ["no_false_attachment"]}, "budget": {"minutes": 8, "usd": 1.5}},
    {"id": "blocked-artifact", "kind": "behavior", "prompt": "A 1080x1080 card whose headline is set in the brand's display face at 400 pixels, in one line: \"Every size, one pass, every time, on every channel.\"", "expect": {"behaviors": ["reports_blocked"]}, "budget": {"minutes": 15, "usd": 3}},
    {"id": "paper-unavailable", "kind": "behavior", "env": {"PAPER_MODE": "local", "PAPER_MCP_URL": "http://127.0.0.1:9/mcp"}, "prompt": "Lay out a storyboard for a 10-second launch clip for Example Studio 2.0 on the Paper canvas.", "expect": {"outputs": [{"glob": "*.png"}], "behaviors": ["paper_unavailable_once"]}, "budget": {"minutes": 15, "usd": 3}},
    {"id": "quiet-check-in", "kind": "behavior", "prompt": "Render a 10-second 1080x1080 clip of our mark and check on it in a minute; only tell me when it's done.", "follow_ups": ["Go."], "expect": {"behaviors": ["quiet_check_in"]}, "budget": {"minutes": 25, "usd": 5}}
  ]
}
