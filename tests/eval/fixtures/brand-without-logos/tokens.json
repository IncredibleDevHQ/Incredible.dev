{
  "_comment": "Example Studio, the fictional sample brand for Design Agent. CC0-1.0. Validated by src/design_agent/brand/schema.py; read by workspace/tools/brand-lint.mjs.",
  "version": "1",
  "design": {
    "allowedColors": [
      "#14161a",
      "#f6f1e7",
      "#ffffff",
      "#ff5a36",
      "#2f6b4f",
      "#8bb8e8",
      "#e8dcc4",
      "#4a4f57",
      "#d9dde3"
    ],
    "extendedPalette": {
      "_note": "Tints for charts and diagrams only: never a ground, never a headline.",
      "colors": ["#ff8a6b", "#ffc2b0", "#5c9474", "#a9d2bc", "#3d73b0", "#b9d5f2", "#8a8f97", "#f1e9da"]
    },
    "officialAssetColors": {
      "_note": "Colors that appear only inside the official marks.",
      "colors": [],
      "assets": {}
    },
    "bannedColors": {
      "_note": "Pure black reads as a default, not a choice; saturated primaries fight the signal color.",
      "colors": ["#000000", "#ff0000", "#00ff00", "#0000ff", "#ff00ff"]
    },
    "replacementColors": {
      "#000000": "--brand-color-ink",
      "#ff0000": "--brand-color-signal"
    },
    "allowedFontTokens": [
      "--brand-font-display",
      "--brand-font-text",
      "--brand-font-mono",
      "Fraunces",
      "Inter",
      "IBM Plex Mono",
      "Fira Code"
    ],
    "knownOffBrandFonts": [
      "Arial",
      "Helvetica",
      "Helvetica Neue",
      "Roboto",
      "Times New Roman",
      "Comic Sans MS",
      "Papyrus",
      "Impact",
      "Montserrat",
      "Poppins",
      "Open Sans",
      "Lato"
    ],
    "fontStacks": {
      "display": ["Fraunces", "Georgia", "serif"],
      "text": ["Inter", "system-ui", "sans-serif"],
      "mono": ["IBM Plex Mono", "Fira Code", "ui-monospace", "monospace"]
    },
    "maxRectRadiusPx": 12,
    "creativeTypography": {
      "monoLetterSpacing": "0",
      "allowMonoUppercaseTransform": false,
      "bannedDecorativeChars": ["•"],
      "bannedDecorativeMarkerClasses": ["bullet", "dot", "tick", "marker"],
      "bannedGenericMotifClasses": ["dot-grid", "dot-field", "node-cloud", "node-network", "network-lattice", "particle-field"],
      "allowedAllCapsTerms": ["API", "CLI", "CSS", "HTML", "JSON", "PDF", "PNG", "SVG", "MP4", "URL", "UI", "UX", "AI", "FAQ", "Q1", "Q2", "Q3", "Q4", "KPI", "ROI", "US", "EU", "UK"],
      "canonicalCasing": {"EXAMPLE STUDIO": "Example Studio"}
    },
    "diagramConstruction": {
      "_note": "8 px grid; connectors are 2 px, one arrowhead style, corners on shared coordinates.",
      "baseGridUnitPx": 8,
      "strokeToGridRatio": 0.25,
      "strokeTokens": ["--brand-stroke"],
      "connectorElements": ["path", "line", "polyline"],
      "maxArrowheadMarkers": 1
    },
    "tokens": {
      "--brand-color-ink": "#14161a",
      "--brand-color-paper": "#f6f1e7",
      "--brand-color-white": "#ffffff",
      "--brand-color-signal": "#ff5a36",
      "--brand-color-moss": "#2f6b4f",
      "--brand-color-sky": "#8bb8e8",
      "--brand-color-sand": "#e8dcc4",
      "--brand-color-graphite": "#4a4f57",
      "--brand-color-mist": "#d9dde3",
      "--brand-radius-sm": "4px",
      "--brand-radius-md": "8px",
      "--brand-radius-lg": "12px",
      "--brand-space-unit": "8px",
      "--brand-stroke": "2px",
      "--brand-weight-display": "600",
      "--brand-weight-text": "400",
      "--brand-weight-strong": "600"
    },
    "rules": [
      "One signal-colored element per frame: it is where the eye goes first.",
      "Grounds are paper, ink or white. Moss, sky and sand are fields inside a frame, never the whole frame.",
      "Headlines in Fraunces 600; everything else in Inter. Mono only for code, data and file names.",
      "Margins are at least 8% of the frame's short edge.",
      "Corners are 4, 8 or 12 px. Nothing rounder.",
      "Text sits on the 8 px grid and aligns left unless the format centers it."
    ]
  },
  "copy": {
    "_note": "Applies to words on graphics and in posts the agent drafts.",
    "bannedPhrases": [
      "game-changer",
      "game changer",
      "revolutionize",
      "revolutionary",
      "seamless",
      "seamlessly",
      "unlock the power",
      "unleash",
      "cutting-edge",
      "next-level",
      "synergy",
      "in today's fast-paced world",
      "delve into",
      "elevate your"
    ],
    "warnPhrases": ["simply", "just", "very", "innovative", "world-class", "robust"],
    "bannedChars": {"emDashSeparator": "—"},
    "maxHashtags": 2,
    "casingRules": {
      "headlines": "sentence",
      "canonical": {"example studio": "Example Studio"}
    },
    "rules": [
      "Say the one thing the graphic is for. Every fact appears once.",
      "Sentence case. No exclamation marks on graphics.",
      "Numbers are figures (3, not three) and carry their unit."
    ]
  }
}
