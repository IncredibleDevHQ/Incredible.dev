# Copy to .env (or use `design-agent config set KEY=value`) and fill in what you use.

# Model (provider:model). Gateway form: langsmith:provider/model
DESIGN_AGENT_MODEL=anthropic:claude-opus-5-5
DESIGN_AGENT_MODEL_EFFORT=high
DESIGN_AGENT_EPISODE_CODEX_MODEL=   # optional Codex CLI model for episodes
DESIGN_AGENT_HELPER_MODEL=
DESIGN_AGENT_LOOK_MODEL=
DESIGN_AGENT_TOOL_SELECTOR_MODEL=
DESIGN_AGENT_LEARNING_MODEL=        # cheaper model for the post-job review (optional)
DESIGN_AGENT_HELPER_EFFORT_CAP=     # e.g. xhigh: caps every helper's effort for cost
DESIGN_AGENT_MODEL_TIMEOUT_SECONDS=600  # one call's stall ceiling
DESIGN_AGENT_MODEL_BASE_URL=
DESIGN_AGENT_MODEL_API_KEY_ENV=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=               # images; without it, images go through the gateway when you use it
GOOGLE_API_KEY=
LANGSMITH_API_KEY=            # tracing, the agent's trace tools, optional gateway
LANGSMITH_GATEWAY_API_KEY=

# Runtime
DESIGN_AGENT_RUNTIME=local          # local | self_hosted
DESIGN_AGENT_SANDBOX=auto           # auto | docker | host
DESIGN_AGENT_SANDBOX_IMAGE=design-agent-sandbox:local
DESIGN_AGENT_SANDBOX_VCPUS=8
DESIGN_AGENT_SANDBOX_MEM_GIB=16
DESIGN_AGENT_SANDBOX_IDLE_TTL_SECONDS=600
DESIGN_AGENT_SANDBOX_EGRESS_ALLOW=  # the Docker sandbox has no network and reaches none of these
DESIGN_AGENT_MAX_PARALLEL_BUILDERS=3
DESIGN_AGENT_WORKSPACE_ROOT=workspace
DESIGN_AGENT_JOB_BUDGET_USD=        # soft: the agent asks before spending past it
DESIGN_AGENT_RESEARCH_ROOTS=~/Documents/code   # the web app's research: folders holding your repos
DESIGN_AGENT_RESEARCH_OWNER_ID=        # verified UUID allowed to start provider research runs
DESIGN_AGENT_RESEARCH_READER_CONTAINER=  # operator-managed read-only Git reader container
MOONSHOT_API_KEY=                    # optional Kimi research provider
DESIGN_AGENT_RESEARCH_CATALOG_DIR=  # optional read-only directory of per-account repository lists
DESIGN_AGENT_TIMEZONE=UTC           # date note when the channel does not say whose zone
DESIGN_AGENT_CACHE_TTL=1h           # lead prompt-cache lifetime (5m | 1h)
DESIGN_AGENT_HELPER_CACHE_TTL=5m
DESIGN_AGENT_MCP_MAX_TOOLS=8        # MCP tools per call for models without native tool search

# Brand
DESIGN_AGENT_BRAND_PATH=workspace/brand    # falls back to examples/brands/example-studio
DESIGN_AGENT_PRIVATE_FONTS_DIR=private-fonts

# Media (optional)
DESIGN_AGENT_IMAGE_MODEL=gpt-image-2.5-flare
ELEVENLABS_API_KEY=
DESIGN_AGENT_NARRATOR_VOICE_ID=     # optional: the ElevenLabs voice that narrates an episode with no voice picked or cloned in its studio
GROQ_API_KEY=
TYPESAFE_API_KEY=                   # optional: Jev reads an episode's plan; without it the writer's own model does

# Raw footage: each take's recording as it arrived, kept in a folder on this computer, or in S3 (production) or MinIO (development, deploy/dev/compose.yaml)
DESIGN_AGENT_FOOTAGE_DIR=           # optional: a drive of its own for camera files (an external SSD); unset: <workspace>/house/footage
DESIGN_AGENT_FOOTAGE_BUCKET=        # optional: keep it in this bucket instead of the folder
DESIGN_AGENT_CAMERA_DIRS=           # optional: comma-separated folders where a camera's card shows up; unset: /Volumes (macOS), /media, /run/media, /mnt (Linux)
DESIGN_AGENT_S3_ENDPOINT=           # MinIO: http://127.0.0.1:9400 ; unset for AWS S3
DESIGN_AGENT_S3_REGION=             # the bucket's AWS region; MinIO takes any
AWS_ACCESS_KEY_ID=                  # MinIO: its root user. On AWS leave these unset to use the machine's role
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=                  # only with temporary AWS credentials

# Optional MCP
EXA_API_KEY=

# Behavior (progress, footer and steering are read by the runtime's presenter)
DESIGN_AGENT_ENABLE_PROGRESS=1
DESIGN_AGENT_ENABLE_FOOTER=1
DESIGN_AGENT_ENABLE_STEERING=1
DESIGN_AGENT_TRACE_HOST=             # LangSmith UI host for a footer's trace link; unset, no link
DESIGN_AGENT_ENABLE_LEARNING=1
DESIGN_AGENT_ENABLE_TRACES=1          # the agent reads every thread's traces in its LangSmith project
DESIGN_AGENT_TEMPLATE_TELEMETRY=1     # traces name the template and version; 0 leaves it off
DESIGN_AGENT_ENABLE_TOOL_CLEARING=0

# Self-hosted
# Supabase Auth and PostgreSQL (server-only credentials; no service-role key in the frontend).
DESIGN_AGENT_AUTH_REQUIRED=0
DESIGN_AGENT_APP_URL=http://127.0.0.1:8765
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Outbound Studio project invitations. Local mail capture uses compose.mailpit.yaml.
DESIGN_AGENT_SMTP_HOST=
DESIGN_AGENT_SMTP_PORT=587
DESIGN_AGENT_SMTP_FROM=
DESIGN_AGENT_SMTP_STARTTLS=true
DESIGN_AGENT_SMTP_USERNAME=
DESIGN_AGENT_SMTP_PASSWORD=
# Native development keeps local files; root Compose forces private S3/MinIO storage.
DESIGN_AGENT_BLOB_BACKEND=local
DESIGN_AGENT_S3_BUCKET=incredible-files
DESIGN_AGENT_S3_ACCESS_KEY=
DESIGN_AGENT_S3_SECRET_KEY=
# Local web Compose: match your host's `id -u` and `id -g` for workspace writes.
LOCAL_UID=1000
LOCAL_GID=1000
DOCKER_SOCKET_PATH=/var/run/docker.sock  # override when your Docker context uses another socket
DATABASE_URL=
POSTGRES_PASSWORD=                  # self-hosted compose
DOCKER_GID=0                        # self-hosted compose: the Docker socket's group
DESIGN_AGENT_API_TOKENS=
DESIGN_AGENT_API_HOST=127.0.0.1
DESIGN_AGENT_API_PORT=8080

# Tests
DESIGN_AGENT_LIVE_TESTS=0           # opt-in tests that call real providers
DESIGN_AGENT_LIVE_VOICE_ID=          # an ElevenLabs voice id for the live voiceover test
